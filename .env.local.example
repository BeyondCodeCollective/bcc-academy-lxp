# ─────────────────────────────────────────────────────────────
# BCC Academy — Environment Variables
# Copy to .env.local and fill in the values.
# ─────────────────────────────────────────────────────────────

# ─── Supabase (required) ─────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ─── Auth / Admins ───────────────────────────────────────────
# Comma-separated emails with elevated privileges
SUPER_ADMIN_EMAILS=admin1@example.com,admin2@example.com
ADMIN_EMAILS=manager@example.com
# Staff emails bypass the invite gate (internal BCC/BGC employees)
STAFF_EMAILS=staff@example.com
# Email domains that qualify as staff (e.g. wearebgc.org)
STAFF_EMAIL_DOMAINS=wearebgc.org,bccacademy.io
# Legacy alias for ADMIN_EMAILS (used by some older code paths)
MASTER_EMAILS=

# ─── Email (Resend) ──────────────────────────────────────────
RESEND_API_KEY=re_...
# From address for sign-in emails (must be from a verified Resend domain)
RESEND_FROM_ADDRESS=BCC Academy <login@mail.bccacademy.io>
# Set to "false" to force Supabase OTP instead of Resend
LOGIN_VIA_RESEND=true
# Email address that receives new-signup notifications
SIGNUP_NOTIFY_EMAIL=team@bccacademy.io

# ─── Mailchimp (optional) ───────────────────────────────────
MAILCHIMP_API_KEY=...
MAILCHIMP_AUDIENCE_ID=...

# ─── Eventbrite (optional) ──────────────────────────────────
EVENTBRITE_API_TOKEN=...
EVENTBRITE_WEBHOOK_SECRET=...

# ─── Zoom (optional — live sessions) ────────────────────────
ZOOM_SDK_KEY=...
ZOOM_SDK_SECRET=...

# ─── Misc ────────────────────────────────────────────────────
# Secret for Vercel Cron auth header (prevents unauthorized /api/warm calls)
CRON_SECRET=your-random-secret-here
# Default program slug when no domain/cookie resolves
DEFAULT_PROGRAM=catalyst
# Secret for the data-withdrawal flow (privacy page)
WITHDRAW_SECRET=another-random-secret
