# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.local.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# gsd tooling
/gsd-2/

# local-only tooling output
/graphify-out/
# campaign participant lists + send logs (PII — never commit)
/scripts/*.local.*
# /scripts/ — removed; scripts dir is used for build helpers
.env*.local

# Playwright
/test-results/
/playwright-report/
/blob-report/
/.playwright/
# Scraper browser profiles — contain Cookies/Login Data; never commit
**/.playwright-state/

# Zoom SDK static assets (copied from node_modules at build time)
/public/zoom/
