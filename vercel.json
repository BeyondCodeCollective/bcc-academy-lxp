{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "src/app/**/route.ts": { "memory": 3008, "maxDuration": 120 },
    "src/app/**/page.tsx": { "memory": 3008, "maxDuration": 120 }
  },
  "crons": [
    {
      "path": "/api/warm",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/daily-snapshot",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/cron/zoom-attendance",
      "schedule": "0 4 * * *"
    }
  ]
}
