{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "src/app/**/route.ts": {
      "maxDuration": 120
    },
    "src/app/**/page.tsx": {
      "maxDuration": 120
    },
    "src/app/api/cron/zoom-recordings/route.ts": {
      "maxDuration": 800
    }
  },
  "crons": [
    {
      "path": "/api/warm",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/daily-snapshot",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/cron/sentinel",
      "schedule": "0 7 * * *"
    },
    {
      "path": "/api/cron/zoom-attendance",
      "schedule": "0 4 * * *"
    },
    {
      "path": "/api/cron/zoom-recordings",
      "schedule": "30 * * * *"
    },
    {
      "path": "/api/cron/automation",
      "schedule": "0 13 * * *"
    }
  ]
}
